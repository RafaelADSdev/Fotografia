---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import Portfolio from '../components/Portfolio.astro';
import Studio from '../components/Studio.astro';
import Instagram from '../components/Instagram.astro';
import portrait from '../assets/suzzy.webp';
import { whatsappLink } from '../lib/site';
---
<SiteLayout>
  <div class="hero-backdrop">
    <section class="hero shell" aria-labelledby="intro-title">
      <div class="hero-portrait">
        <span class="portrait-frame" aria-hidden="true"></span>
        <Image
          src={portrait}
          alt="Suzzy Alves sorrindo com a câmera na mão"
          widths={[400, 640, 860, 1120]}
          sizes="(min-width: 76rem) 570px, (min-width: 51rem) 48vw, 95vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero-copy">
        <h1 id="intro-title">Olá, eu sou a <em>Suzzy.</em></h1>
        <p>Fotografo gestantes, bebês e famílias no meu estúdio em Guarulhos.</p>
        <div class="hero-actions">
          <a href={whatsappLink()} class="button button-primary" data-booking target="_blank" rel="noopener">
            Agendar <Icon name="diagonal" />
          </a>
          <a class="text-link" href="#ensaios">Conhecer meu trabalho <Icon name="arrow" /></a>
        </div>
      </div>
    </section>
  </div>
  <Portfolio />
  <Studio />
  <Instagram />
</SiteLayout>
