---
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/site.css';
import '../styles/motion.css';
import Icon from '../components/Icon.astro';
import Offer from '../components/Offer.astro';
import { instagramUrl, studio, whatsappLink } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = studio.name, description = 'Ensaios de gestantes, bebês e famílias com Suzzy Alves em Guarulhos.' } = Astro.props;
const studioLink = Astro.url.pathname === '/' ? '#estudio' : '/#estudio';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style is:inline media="(prefers-reduced-motion: no-preference)">
      @view-transition { navigation: auto; }
    </style>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f3ea" />
    <link rel="icon" href="/icone.png" type="image/png" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Ir para o conteúdo</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a href="/" class="wordmark" aria-label={studio.name}>
          <span>Suzzy Alves</span><small>Fotografia</small>
        </a>
        <a class="button button-outline" href={whatsappLink()} data-booking target="_blank" rel="noopener">
          Agendar no WhatsApp <Icon name="diagonal" />
        </a>
      </div>
    </header>
    <main id="conteudo" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <a href="/" class="wordmark" aria-label={studio.name}>
          <span>Suzzy Alves</span><small>Fotografia</small>
        </a>
        <div class="footer-links">
          <a class="text-link" href={studioLink}>Estúdio em Guarulhos <Icon name="arrow" /></a>
          <a class="text-link" href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram <Icon name="diagonal" /></a>
        </div>
      </div>
      <div class="footer-credit">
        <div class="shell footer-credit-inner">
          <span>Feito por Vercuno</span>
          <img src="/vercuno-branco-roxo.png" width="2160" height="422" alt="" loading="lazy" />
        </div>
      </div>
    </footer>
    <Offer />
  </body>
</html>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const reveal = new IntersectionObserver((entries, observer) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-revealed');
        observer.unobserve(entry.target);
      }
    }, { threshold: 0.12 });

    for (const element of document.querySelectorAll('[data-scroll-reveal]')) reveal.observe(element);
  }
</script>
