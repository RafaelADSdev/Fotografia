---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import portrait from '../assets/suzzy-estudio.webp';
import { studio, whatsappLink } from '../lib/site';

const point = `${studio.latitude},${studio.longitude}`;
const bounds = [studio.longitude - 0.004, studio.latitude - 0.003, studio.longitude + 0.004, studio.latitude + 0.003];
const embed = new URL('https://www.openstreetmap.org/export/embed.html');
embed.search = new URLSearchParams({ bbox: bounds.join(','), layer: 'mapnik', marker: point }).toString();
const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(point)}`;
---
<section class="studio-section" id="estudio" aria-labelledby="estudio-title" tabindex="-1">
  <div class="shell">
    <h2 id="estudio-title">Local e <em>horários</em></h2>
    <div class="studio-grid">
      <div class="studio-card" data-scroll-reveal>
        <div class="studio-copy">
          <div class="studio-details">
            <div>
              <h3>Endereço</h3>
              <address>{studio.street}<br />{studio.neighborhood} · {studio.city}</address>
            </div>
            <div>
              <h3>Atendimento</h3>
              <p>{studio.hours}</p>
            </div>
          </div>
          <div class="studio-actions">
            <a class="button button-primary" href={directions} target="_blank" rel="noopener">Como chegar <Icon name="diagonal" /></a>
            <a class="text-link" href={whatsappLink()} data-booking target="_blank" rel="noopener">Agendar ensaio <Icon name="diagonal" /></a>
          </div>
        </div>
        <Image
          class="studio-portrait"
          src={portrait}
          alt="Suzzy Alves ao lado de sua câmera"
          widths={[380, 640, 960, 1200]}
          sizes="(min-width: 76rem) 555px, (min-width: 51rem) 43vw, 92vw"
          loading="lazy"
        />
      </div>
      <div class="map-frame" data-scroll-reveal>
        <iframe class="studio-map" title="Mapa do estúdio Suzzy Alves Fotografia" src={embed.href} loading="lazy"></iframe>
      </div>
    </div>
  </div>
</section>
