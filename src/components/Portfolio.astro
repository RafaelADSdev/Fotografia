---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { albums } from '../lib/albums';
import { whatsappLink } from '../lib/site';

const firstAlbum = albums[0];
const firstPhoto = firstAlbum?.photos[0];
const previews = albums.map((album) => ({ ...album, photos: album.photos.slice(0, 4) }));
const initialCount = previews[0]?.photos.length ?? 0;
const maxCount = Math.max(0, ...previews.map(({ photos }) => photos.length));
const photoSizes = '(min-width: 76rem) 760px, (min-width: 51rem) 61vw, 94vw';
const photoWidths = (width: number) => [400, 720, 1080, 1440].filter((size) => size <= width);
---
{firstAlbum && firstPhoto && (
  <section class="portfolio" id="ensaios" aria-labelledby="ensaios-title" data-carousel>
    <div class="shell portfolio-inner">
      <h2 id="ensaios-title" data-scroll-reveal>Ensaios</h2>
      <div class="portfolio-grid">
        <div class="album-options" role="group" aria-label="Selecionar tipo de ensaio" data-scroll-reveal data-carousel-ui hidden>
          {previews.filter(({ featured }) => featured).map((album) => (
            <button class="featured-album" type="button" data-album={album.slug} data-label={album.label} aria-pressed={album.slug === firstAlbum.slug}>
              {album.label} <Icon name="diagonal" />
            </button>
          ))}
          <div class="compact-albums">
            {previews.filter(({ featured }) => !featured).map((album) => (
              <button type="button" data-album={album.slug} data-label={album.label} aria-pressed="false">{album.label}</button>
            ))}
          </div>
        </div>
        <div class="carousel-view" role="group" aria-roledescription="carrossel" aria-label="Fotos dos ensaios" data-carousel-view data-scroll-reveal>
          <div class="carousel-stage" data-portfolio-view>
            <div class="carousel-image" data-carousel-image>
              <Image src={firstPhoto} alt={`Foto 1 do ensaio de ${firstAlbum.label}`} widths={photoWidths(firstPhoto.width)} sizes={photoSizes} loading="lazy" draggable="false" />
            </div>
            <p class="carousel-status visually-hidden" role="status" data-carousel-status></p>
            <div class="carousel-arrows" data-carousel-ui hidden>
              <button class="icon-button" type="button" aria-label="Foto anterior" data-slide-step="-1"><Icon name="left" /></button>
              <button class="icon-button" type="button" aria-label="Próxima foto" data-slide-step="1"><Icon name="right" /></button>
            </div>
          </div>
          <div class="carousel-meta" data-carousel-ui hidden>
            <span data-carousel-counter>1 / {initialCount}</span>
            <div class="carousel-positions" role="group" aria-label="Escolher foto">
              {Array.from({ length: maxCount }, (_, index) => (
                <button type="button" aria-label={`Mostrar foto ${index + 1}`} aria-current={index === 0 ? 'true' : undefined} data-slide-index={index} hidden={index >= initialCount}></button>
              ))}
            </div>
            <button class="icon-button rotation-button" type="button" data-rotation aria-label="Pausar reprodução automática">
              <Icon name="pause" />
              <Icon name="play" />
            </button>
          </div>
        </div>
        <div class="portfolio-actions" data-scroll-reveal>
          <a class="button button-primary" href={whatsappLink(firstAlbum.label)} data-booking data-carousel-booking target="_blank" rel="noopener">Agendar no WhatsApp <Icon name="diagonal" /></a>
          <a class="text-link" href={`/galeria/#${firstAlbum.slug}`} data-gallery-link>Ver álbum completo <Icon name="arrow" /></a>
        </div>
      </div>
      {previews.flatMap((album) => album.photos.map((photo, index) => (
        <template data-slide={album.slug}>
          <Image src={photo} alt={`Foto ${index + 1} do ensaio de ${album.label}`} widths={photoWidths(photo.width)} sizes={photoSizes} loading="eager" draggable="false" />
        </template>
      )))}
    </div>
  </section>
)}

<script>
  import { setBookingCategory } from '../scripts/booking';

  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  if (carousel) initCarousel(carousel);

  function initCarousel(root: HTMLElement) {
    const choices = [...root.querySelectorAll<HTMLButtonElement>('[data-album]')];
    const templates = [...root.querySelectorAll<HTMLTemplateElement>('[data-slide]')];
    const view = root.querySelector<HTMLElement>('[data-carousel-view]');
    const image = root.querySelector<HTMLElement>('[data-carousel-image]');
    const counter = root.querySelector<HTMLElement>('[data-carousel-counter]');
    const status = root.querySelector<HTMLElement>('[data-carousel-status]');
    const rotation = root.querySelector<HTMLButtonElement>('[data-rotation]');
    const gallery = root.querySelector<HTMLAnchorElement>('[data-gallery-link]');
    const stage = root.querySelector<HTMLElement>('.carousel-stage');
    const positions = [...root.querySelectorAll<HTMLButtonElement>('[data-slide-index]')];
    let selected = choices[0];
    if (!selected || !view || !image || !counter || !status || !rotation || !gallery || !stage) return;

    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const easing = getComputedStyle(root).getPropertyValue('--motion-out').trim();
    let slides = slidesFor(selected);
    let index = 0;
    let visible = false;
    let hovered = false;
    let paused = motion.matches;
    let timer: number | undefined;
    let requestedFrame = 0;
    let swipe: { id: number; x: number; y: number } | undefined;
    const photoError = 'A foto não carregou. Use as setas para ver outra.';

    function setStatus(message: string, visible = false) {
      status!.classList.toggle('visually-hidden', !visible);
      status!.textContent = message;
    }

    function setPosition(position: number, count: number) {
      counter!.textContent = `${position} / ${count}`;
      positions.forEach((button, offset) => {
        button.hidden = offset >= count;
        if (offset === position - 1) button.setAttribute('aria-current', 'true');
        else button.removeAttribute('aria-current');
      });
    }

    const initialPhoto = image.querySelector('img');
    function onInitialPhotoError() {
      if (!requestedFrame) setStatus(photoError, true);
    }
    initialPhoto?.addEventListener('error', onInitialPhotoError, { once: true });
    if (initialPhoto?.complete && !initialPhoto.naturalWidth) onInitialPhotoError();

    function slidesFor(button: HTMLButtonElement) {
      return templates.filter((slide) => slide.dataset.slide === button.dataset.album);
    }

    function syncRotation() {
      window.clearTimeout(timer);
      rotation!.dataset.paused = String(paused);
      rotation!.ariaLabel = paused ? 'Retomar reprodução automática' : 'Pausar reprodução automática';
      if (!paused && !hovered && visible && !document.hidden && slides.length > 1) {
        timer = window.setTimeout(() => {
          showSlide(index + 1, { announce: false, duration: 500 });
          syncRotation();
        }, 5000);
      }
    }

    function showSlide(next: number, { announce = true, duration = 320, direction = 0 } = {}) {
      index = (next + slides.length) % slides.length;
      const template = slides[index];
      if (!template) return;
      const fragment = document.importNode(template.content, true);
      const photo = fragment.querySelector('img');
      if (!photo) return;
      const request = ++requestedFrame;
      const position = index + 1;
      const count = slides.length;
      const loading = announce ? window.setTimeout(() => {
        if (request !== requestedFrame) return;
        setPosition(position, count);
        setStatus('Carregando foto…', true);
      }, 120) : undefined;

      function render() {
        if (request !== requestedFrame) return;
        if (motion.matches || !duration) {
          image!.replaceChildren(fragment);
        } else {
          const outgoing = status!.classList.contains('visually-hidden') ? image!.lastElementChild : null;
          if (outgoing) {
            image!.querySelectorAll('[aria-hidden="true"]').forEach((frame) => frame.remove());
            outgoing.setAttribute('aria-hidden', 'true');
            image!.append(fragment);
          } else {
            image!.replaceChildren(fragment);
          }
          const x = direction * 24;
          const y = announce && !direction ? 12 : 0;
          const scale = announce ? 1.04 : 1.018;
          const fade = photo!.animate([
            { opacity: outgoing ? 0 : .3, transform: `translate(${x}px, ${y}px) scale(${scale})` },
            { opacity: 1, transform: 'none' },
          ], { duration, easing });
          fade.onfinish = () => outgoing?.remove();
        }
        setPosition(position, count);
        setStatus(announce ? `${selected.dataset.label}, foto ${position} de ${count}` : '');
      }

      void photo.decode().then(render, () => {
        if (request !== requestedFrame) return;
        setPosition(position, count);
        setStatus(photoError, true);
      }).finally(() => window.clearTimeout(loading));
    }

    for (const button of choices) {
      button.addEventListener('click', (event) => {
        selected.setAttribute('aria-pressed', 'false');
        selected = button;
        selected.setAttribute('aria-pressed', 'true');
        slides = slidesFor(button);
        gallery.href = `/galeria/#${button.dataset.album}`;
        setBookingCategory(button.dataset.label ?? '');
        showSlide(0, { duration: event.detail ? 390 : 0 });
        syncRotation();
      });
    }

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-slide-step]')) {
      button.addEventListener('click', (event) => {
        const step = Number(button.dataset.slideStep);
        showSlide(index + step, { duration: event.detail ? 320 : 0, direction: step });
        syncRotation();
      });
    }

    for (const [offset, button] of positions.entries()) {
      button.addEventListener('click', (event) => {
        if (offset === index && status.classList.contains('visually-hidden')) return;
        showSlide(offset, { duration: event.detail ? 320 : 0, direction: Math.sign(offset - index) });
        syncRotation();
      });
    }

    stage.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'touch' || !event.isPrimary || (event.target as HTMLElement).closest('button')) return;
      swipe = { id: event.pointerId, x: event.clientX, y: event.clientY };
    });
    stage.addEventListener('pointercancel', () => { swipe = undefined; });
    stage.addEventListener('pointerup', (event) => {
      if (swipe?.id !== event.pointerId) return;
      const dx = event.clientX - swipe.x;
      const dy = event.clientY - swipe.y;
      swipe = undefined;
      if (Math.abs(dx) < 44 || Math.abs(dx) < Math.abs(dy) * 1.25) return;
      const direction = dx < 0 ? 1 : -1;
      showSlide(index + direction, { direction });
      syncRotation();
    });

    rotation.addEventListener('click', () => {
      paused = !paused;
      syncRotation();
    });
    root.addEventListener('focusin', (event) => {
      if (!root.contains(event.relatedTarget as Node | null) && event.target instanceof HTMLElement && event.target.matches(':focus-visible')) {
        paused = true;
        syncRotation();
      }
    });
    root.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') {
        hovered = true;
        syncRotation();
      }
    });
    root.addEventListener('pointerleave', () => {
      hovered = false;
      syncRotation();
    });
    document.addEventListener('visibilitychange', syncRotation);
    motion.addEventListener('change', () => {
      paused = motion.matches;
      if (motion.matches) {
        image.querySelectorAll('[aria-hidden="true"]').forEach((frame) => frame.remove());
        image.getAnimations({ subtree: true }).forEach((animation) => animation.cancel());
      }
      syncRotation();
    });
    new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? false;
      syncRotation();
    }, { threshold: 0.2 }).observe(view);

    for (const element of root.querySelectorAll<HTMLElement>('[data-carousel-ui]')) element.hidden = false;
    syncRotation();
  }
</script>
