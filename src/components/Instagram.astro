---
import Icon from './Icon.astro';
import { instagramUrl, studio } from '../lib/site';
---
<section class="instagram-section" id="instagram" aria-labelledby="instagram-title">
  <div class="shell instagram-layout">
    <div class="instagram-intro" data-scroll-reveal>
      <h2 id="instagram-title">Ensaios no <em>Instagram</em></h2>
      <a class="button button-outline" href={instagramUrl} target="_blank" rel="noopener noreferrer">
        @{studio.instagram} <Icon name="diagonal" />
      </a>
    </div>
    <div class="instagram-panel" data-scroll-reveal>
      <iframe
        title={`Publicações do Instagram de @${studio.instagram}`}
        src={`${instagramUrl}embed/`}
        width="540"
        height="640"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .instagram-section {
    padding-block: clamp(2.25rem, 5vw, 4.8rem);
    scroll-margin-top: var(--header-height);
    border-top: 1px solid var(--line);
    background: var(--light);
  }
  .instagram-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(1.25rem, 5vw, 4rem);
  }
  .instagram-intro h2 {
    margin-bottom: 1.35rem;
    font-size: clamp(3.25rem, 6.4vw, 6rem);
    letter-spacing: -.04em;
    line-height: .94;
  }
  .instagram-intro em { display: block; }
  .instagram-panel {
    min-width: 0;
    max-width: 38rem;
    width: 100%;
    justify-self: end;
    padding: clamp(.3rem, .7vw, .55rem);
    border: 1px solid var(--line);
    background: var(--paper);
  }
  .instagram-panel iframe {
    display: block;
    width: 100%;
    height: 40rem;
    border: 0;
    background: #fff;
  }
  @media (max-width: 50.99rem) {
    .instagram-layout { grid-template-columns: minmax(0, 1fr); }
    .instagram-intro em { display: inline; }
    .instagram-panel { justify-self: start; }
    .instagram-panel iframe { height: clamp(28rem, 100vw, 40rem); }
  }
</style>
